{
	"schemaVersion": 1,
	"id": "paybuttons",
	"version": "${version}",
	"name": "Cams321 Payment Mod",
	"description": "Adds clickable [X] and [2X] buttons to incoming payment messages that run /pay for you.",
	"authors": ["Cams321"],
	"license": "MIT",
	"environment": "client",
	"mixins": ["paybuttons.mixins.json"],
	"entrypoints": {
		"client": ["com.example.paybuttons.PayButtonsMod"]
	},
	"depends": {
		"fabricloader": ">=0.18.0",
		"minecraft": ">=1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	}
}
